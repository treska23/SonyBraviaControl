<Window x:Class="SonyBraviaControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sony Bravia Control"
        Width="500"
        Height="900"
        MinWidth="340"
        MinHeight="480"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12" Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10" Background="{StaticResource AppBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel MinWidth="0" Margin="2,0,8,0">
                <TextBlock Text="Sony Bravia Control"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding DeviceName}"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource ChromeBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10,7"
                    MaxWidth="190">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Background="{StaticResource AppBackground}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
            <StackPanel HorizontalAlignment="Stretch" MaxWidth="560" Background="{StaticResource AppBackground}">
                <Expander Header="Conexión y ajustes"
                          Margin="0,0,0,12"
                          Foreground="{StaticResource TextPrimary}">
                    <Border Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource ChromeBorder}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP de la tele" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Puerto" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,10" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="MAC (para encender por red)" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding MacAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" ToolTip="Ejemplo: AA:BB:CC:DD:EE:FF" />

                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                                <TextBlock Text="PSK Sony · control IP rápido" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PreSharedKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" ToolTip="La misma clave configurada en Ajustes de la TV → Red → Control IP. Déjalo vacío si la TV permite autenticación None." />
                                <TextBlock Text="Si arriba aparece ‘ADB (lento)’, activa Control IP en la tele y configura aquí su Pre-Shared Key."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="ADB" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AdbPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Conectar" Command="{Binding ConnectCommand}" Style="{StaticResource AccentButton}" />
                                    <Button Grid.Column="1" Content="Desconectar" Command="{Binding DisconnectCommand}" Style="{StaticResource RemoteButton}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>

                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1" CornerRadius="22" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <UniformGrid Columns="3">
                            <Button Content="⏻  Encender" Command="{Binding WakeCommand}" Style="{StaticResource DangerButton}" />
                            <Button Content="Reposo" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_SLEEP" Style="{StaticResource RemoteButton}" />
                            <Button Content="Menú fuentes" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_TV_INPUT" Style="{StaticResource RemoteButton}" />
                        </UniformGrid>

                        <TextBlock Text="Entradas directas" Foreground="{StaticResource TextSecondary}" Margin="5,10,0,5" />
                        <UniformGrid Columns="4" Margin="0,0,0,4">
                            <Button Content="HDMI 1" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_TV_INPUT_HDMI_1" Style="{StaticResource RemoteButton}" />
                            <Button Content="HDMI 2" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_TV_INPUT_HDMI_2" Style="{StaticResource RemoteButton}" />
                            <Button Content="HDMI 3" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_TV_INPUT_HDMI_3" Style="{StaticResource RemoteButton}" />
                            <Button Content="HDMI 4" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_TV_INPUT_HDMI_4" Style="{StaticResource RemoteButton}" />
                        </UniformGrid>

                        <Viewbox Stretch="Uniform"
                                 StretchDirection="DownOnly"
                                 HorizontalAlignment="Stretch"
                                 MaxWidth="330"
                                 MaxHeight="270"
                                 Margin="0,8,0,6">
                            <Grid Width="330" Height="270">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="1" Content="▲" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_DPAD_UP" Style="{StaticResource RemoteButton}" FontSize="23" />
                                <Button Grid.Row="1" Grid.Column="0" Content="◀" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_DPAD_LEFT" Style="{StaticResource RemoteButton}" FontSize="23" />
                                <Button Grid.Row="1" Grid.Column="1" Content="OK" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_DPAD_CENTER" Style="{StaticResource AccentButton}" FontSize="18" />
                                <Button Grid.Row="1" Grid.Column="2" Content="▶" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_DPAD_RIGHT" Style="{StaticResource RemoteButton}" FontSize="23" />
                                <Button Grid.Row="2" Grid.Column="1" Content="▼" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_DPAD_DOWN" Style="{StaticResource RemoteButton}" FontSize="23" />
                            </Grid>
                        </Viewbox>

                        <UniformGrid Columns="3">
                            <Button Content="⌂  Home" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_HOME" Style="{StaticResource RemoteButton}" />
                            <Button Content="←  Atrás" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_BACK" Style="{StaticResource RemoteButton}" />
                            <Button Content="☰  Menú" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_MENU" Style="{StaticResource RemoteButton}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1" CornerRadius="18" Padding="10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Volumen" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                            <Button Content="＋" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_VOLUME_UP" Style="{StaticResource RemoteButton}" FontSize="22" />
                            <Button Content="Silencio" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_VOLUME_MUTE" Style="{StaticResource RemoteButton}" />
                            <Button Content="－" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_VOLUME_DOWN" Style="{StaticResource RemoteButton}" FontSize="22" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Canal" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                            <Button Content="CH ＋" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_CHANNEL_UP" Style="{StaticResource RemoteButton}" />
                            <Button Content="TV" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_TV" Style="{StaticResource RemoteButton}" />
                            <Button Content="CH －" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_CHANNEL_DOWN" Style="{StaticResource RemoteButton}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1" CornerRadius="18" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Reproducción" Foreground="{StaticResource TextSecondary}" Margin="5,0,0,5" />
                        <UniformGrid Columns="4">
                            <Button Content="⏪" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_MEDIA_REWIND" Style="{StaticResource RemoteButton}" />
                            <Button Content="⏯" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_MEDIA_PLAY_PAUSE" Style="{StaticResource AccentButton}" />
                            <Button Content="■" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_MEDIA_STOP" Style="{StaticResource RemoteButton}" />
                            <Button Content="⏩" Command="{Binding SendKeyCommand}" CommandParameter="KEYCODE_MEDIA_FAST_FORWARD" Style="{StaticResource RemoteButton}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1" CornerRadius="18" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Apps" Foreground="{StaticResource TextSecondary}" Margin="5,0,0,5" />
                        <UniformGrid Columns="2">
                            <Button Content="Projectivy" Command="{Binding LaunchAppCommand}" CommandParameter="com.spocky.projengmenu" Style="{StaticResource AccentButton}" />
                            <Button Content="Netflix" Command="{Binding LaunchAppCommand}" CommandParameter="com.netflix.ninja" Style="{StaticResource RemoteButton}" />
                            <Button Content="YouTube" Command="{Binding LaunchAppCommand}" CommandParameter="com.google.android.youtube.tv" Style="{StaticResource RemoteButton}" />
                            <Button Content="Prime Video" Command="{Binding LaunchAppCommand}" CommandParameter="com.amazon.amazonvideo.livingroom" Style="{StaticResource RemoteButton}" />
                            <Button Content="Disney+" Command="{Binding LaunchAppCommand}" CommandParameter="com.disney.disneyplus" Style="{StaticResource RemoteButton}" />
                            <Button Content="Movistar+" Command="{Binding LaunchAppCommand}" CommandParameter="com.movistarplus.androidtv" Style="{StaticResource RemoteButton}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1" CornerRadius="18" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Escribir en la tele" Foreground="{StaticResource TextSecondary}" Margin="5,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TextToSend, UpdateSourceTrigger=PropertyChanged}" Margin="5" MinWidth="0" />
                            <Button Grid.Column="1" Content="Enviar" Command="{Binding SendTextCommand}" Style="{StaticResource AccentButton}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <Button Content="Reconectar" Command="{Binding ConnectCommand}" Style="{StaticResource RemoteButton}" />
                    <Button Content="Reiniciar Android TV" Command="{Binding RebootCommand}" Style="{StaticResource DangerButton}" />
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
