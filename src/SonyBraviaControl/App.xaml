<Application x:Class="SonyBraviaControl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Sony design traditionally leans on black/white/silver with one restrained
             product accent. For BRAVIA we keep the UI near-black and use a cinematic
             electric blue only for the controls that need emphasis. -->
        <SolidColorBrush x:Key="AppBackground" Color="#060708" />
        <SolidColorBrush x:Key="PanelBackground" Color="#101317" />
        <SolidColorBrush x:Key="ButtonBackground" Color="#191E24" />
        <SolidColorBrush x:Key="ButtonHover" Color="#242B33" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3A8DFF" />
        <SolidColorBrush x:Key="AccentBackground" Color="#102A4D" />
        <SolidColorBrush x:Key="AccentBorder" Color="#2F7FEA" />
        <SolidColorBrush x:Key="ChromeBorder" Color="#323A43" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E64B55" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F6F8" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A7B0BA" />

        <!-- Discreet BRAVIA scrollbar palette. The track almost disappears into the
             window and the thumb only picks up Sony blue while interacting with it. -->
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#090C10" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#313B47" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#46586F" />
        <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#3A8DFF" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource AppBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style x:Key="RemoteButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ButtonHover}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#53606D" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0D223F" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource RemoteButton}">
            <Setter Property="Background" Value="{StaticResource AccentBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorder}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource RemoteButton}">
            <Setter Property="Background" Value="#321317" />
            <Setter Property="BorderBrush" Value="#7A2C34" />
            <Setter Property="Foreground" Value="#FFECEF" />
        </Style>

        <Style x:Key="BraviaScrollThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface"
                                Margin="1"
                                CornerRadius="4"
                                Background="{StaticResource ScrollThumbBrush}"
                                Opacity="0.78" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource ScrollThumbPressedBrush}" />
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global ScrollBar style: no Windows arrow buttons, no white gutter, only an
             8 px dark rail and a rounded thumb. This also keeps future scrollable areas
             visually consistent without having to style them one by one. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource ScrollTrackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ScrollThumbBrush}" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False"
                                                  Opacity="0"
                                                  IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource BraviaScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False"
                                                  Opacity="0"
                                                  IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="8" />
                                <Setter Property="MinHeight" Value="8" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A0D10" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        </Style>
    </Application.Resources>
</Application>
